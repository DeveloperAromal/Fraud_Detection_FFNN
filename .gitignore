# Centralized Git ignore for Fraud_Detection_FFNN
# Language: Python

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/
# Match common local names too
./venv*

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json

# Jupyter Notebook
.ipynb_checkpoints/

# IDE / Editor
.vscode/
.idea/
*.code-workspace

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Application artifacts
*.pt
*.pth

# Environment files (keep example variants tracked)
.env
.env.*
!.env.example
